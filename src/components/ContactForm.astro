---
import Icon from './Icon.astro';
---
<button class="button" type="button" data-contact-open>Contact Mirko <Icon name="arrow_forward" /></button>
<dialog class="contact-dialog" aria-labelledby="contact-title">
  <button class="contact-close" type="button" aria-label="Close contact form"><Icon name="close" /></button>
  <h2 id="contact-title">Company sponsorship</h2>
  <div class="contact-intro">
    <p>Tell Mirko what your team would like to support. You can include your website and a link to your logo.</p>
    <button class="button primary contact-next" type="button">Continue <Icon name="arrow_forward" /></button>
  </div>
  <form class="contact-form" action="https://formsubmit.co/brombin94@gmail.com" method="POST" hidden>
    <input type="hidden" name="_subject" value="Raven sponsor inquiry" />
    <input type="hidden" name="_captcha" value="false" />
    <input type="text" name="_honey" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label for="contact-company">Company name</label>
    <input id="contact-company" name="Company" required maxlength="160" autocomplete="organization" />
    <label for="contact-email">Your email</label>
    <input id="contact-email" type="email" name="Email" required maxlength="254" autocomplete="email" />
    <label for="contact-website">Website <span>(optional)</span></label>
    <input id="contact-website" type="url" name="Website" maxlength="2048" placeholder="https://" autocomplete="url" />
    <label for="contact-message">Message <span>(optional)</span></label>
    <textarea id="contact-message" name="Message" rows="4" maxlength="5000" placeholder="How would you like to support Raven?"></textarea>
    <label for="contact-answer">Quick check: what is <strong class="contact-question"></strong>?</label>
    <input id="contact-answer" inputmode="numeric" autocomplete="off" required />
    <button class="button primary contact-send" type="submit" disabled>Send message <Icon name="arrow_forward" /></button>
  </form>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.contact-dialog');
  const form = dialog?.querySelector<HTMLFormElement>('.contact-form');
  const intro = dialog?.querySelector<HTMLElement>('.contact-intro');
  const answer = dialog?.querySelector<HTMLInputElement>('#contact-answer');
  const send = dialog?.querySelector<HTMLButtonElement>('.contact-send');
  let expected = 0;
  if (dialog && form && intro && answer && send) {
    document.querySelector('[data-contact-open]')?.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('.contact-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.contact-next')?.addEventListener('click', () => {
      const a = 2 + Math.floor(Math.random() * 7);
      const b = 2 + Math.floor(Math.random() * 7);
      expected = a + b;
      dialog.querySelector('.contact-question')!.textContent = `${a} + ${b}`;
      intro.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('#contact-company')!.focus();
    });
    answer.addEventListener('input', () => { send.disabled = Number(answer.value.trim()) !== expected; });
    form.addEventListener('submit', event => {
      if (Number(answer.value.trim()) !== expected) event.preventDefault();
    });
    dialog.addEventListener('close', () => {
      form.reset();
      form.hidden = true;
      intro.hidden = false;
      send.disabled = true;
    });
    dialog.addEventListener('click', event => {
      const bounds = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
    });
  }
</script>
<style>
  .contact-dialog { width: min(540px, calc(100% - 32px)); max-height: calc(100dvh - 40px); padding: 36px; border: 1px solid var(--border); border-radius: 10px; background: var(--page); color: var(--text); }
  .contact-dialog::backdrop { background: #0009; }
  .contact-dialog h2 { max-width: calc(100% - 32px); font-size: 30px; line-height: 1.15; }
  .contact-dialog p { margin: 24px 0; font-size: 17px; line-height: 25px; }
  .contact-close { position: absolute; top: 16px; right: 12px; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 5px; background: transparent; color: var(--text); cursor: pointer; }
  .contact-close:hover { background: var(--button-hover); }
  .contact-form { display: grid; gap: 9px; margin-top: 28px; }
  .contact-form[hidden], .contact-intro[hidden] { display: none; }
  .contact-form label { margin-top: 9px; font-size: 15px; font-weight: 700; }
  .contact-form label span { color: var(--muted); font-weight: 400; }
  .contact-form input:not([type='hidden']), .contact-form textarea { width: 100%; min-height: 44px; padding: 11px 12px; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--surface); color: var(--text); font: inherit; font-size: 16px; }
  .contact-form input:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .contact-form textarea { resize: vertical; }
  .contact-form .contact-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .contact-send { margin-top: 16px; cursor: pointer; }
  .contact-send:disabled { opacity: .45; cursor: default; }
  @media (max-width: 700px) { .contact-dialog { padding: 28px 22px; } }
</style>
