---
import data from '../data/benchmarks.json';
import Icon from './Icon.astro';

const runtimes = [
  { key: 'Raven', label: 'Raven', raven: true },
  { key: 'Wine 11.0', label: 'Wine 11.0' },
  { key: 'Soda 11.0-32 exp.', label: 'Soda 11.0-32' },
];
const workloads = [
  { title: 'Process start-up', detail: 'A program that exits at once', values: data.cli.startup, unit: 's', lower: true, digits: 2 },
  { title: 'SQLite query', detail: 'Eight million rows, including process start-up', values: data.cli.sqlite, unit: 's', lower: true, digits: 2 },
  { title: 'Direct3D 11 frames', detail: '2,000 frames through DXVK', values: data.frames['d3d11-present'], unit: 'fps', lower: false, digits: 0 },
  { title: 'ClassiCube', detail: 'Singleplayer, Direct3D 11', values: data.games['ClassiCube 1.3.8 singleplayer'], unit: 'fps', lower: false, digits: 1, pending: false },
  { title: 'Notepad++ window', detail: 'Time until the main window appears', values: data.apps['notepad++'], unit: 's', lower: true, digits: 2 },
];
const rows = workloads.map(workload => {
  const values = runtimes.map(runtime => ({ ...runtime, value: workload.values[runtime.key]?.value ?? null }));
  const largest = Math.max(...values.map(entry => entry.value ?? 0));
  return {
    ...workload,
    bars: values.map(entry => ({
      ...entry,
      height: entry.value === null ? 0 : Math.max(3, entry.value / largest * 172),
      text: entry.value === null ? 'did not finish' : `${entry.value.toLocaleString('en', { minimumFractionDigits: workload.digits, maximumFractionDigits: workload.digits })} ${workload.unit}`,
    })),
  };
});
---
<section class="benchmarks-section" aria-labelledby="benchmarks-heading">
  <h2 id="benchmarks-heading">Fast where it counts.</h2>
  <p>Preliminary results on the same machine, using software Vulkan. ClassiCube uses four alternating rounds with a fixed world seed.</p>
  <div class="benchmark-carousel">
    <button type="button" class="benchmark-previous" aria-label="Previous benchmark" aria-controls="benchmark-cards" disabled hidden><Icon name="arrow_back" /></button>
    <div class="benchmark-grid" id="benchmark-cards" tabindex="0" role="group" aria-roledescription="carousel" aria-label="Benchmark cards">
      {rows.map((row, index) => (
        <figure class="benchmark-card" role="group" aria-roledescription="slide" aria-label={`${row.title}, ${index + 1} of ${rows.length}`}>
          <figcaption>
            <strong>{row.title}</strong>
            <span>{row.detail}{!row.pending && ` · ${row.lower ? 'lower is better' : 'higher is better'}`}</span>
          </figcaption>
          {row.pending ? <p class="benchmark-pending">New comparison in progress.<span>Results will appear once the run configuration is verified.</span></p> : (
            <dl>
              {row.bars.map(bar => (
                <div class:list={['benchmark-row', { raven: bar.raven, missing: bar.value === null }]}>
                  <dt>{bar.label}</dt>
                  <dd>
                    <span class="benchmark-value">{bar.text}</span>
                    <span class="benchmark-bar" style={`height: ${bar.height}px`} aria-hidden="true"></span>
                  </dd>
                </div>
              ))}
            </dl>
          )}
        </figure>
      ))}
    </div>
    <button type="button" class="benchmark-next" aria-label="Next benchmark" aria-controls="benchmark-cards" hidden><Icon name="arrow_forward" /></button>
  </div>
  <output class="benchmark-position" aria-label="Current benchmark" aria-live="polite">1 / {rows.length}</output>
  <a class="button" href="/docs/benchmarks/">How these were measured <Icon name="arrow_forward" /></a>
</section>
<script>
  const carousel = document.querySelector<HTMLElement>('#benchmark-cards');
  const previous = document.querySelector<HTMLButtonElement>('.benchmark-previous');
  const next = document.querySelector<HTMLButtonElement>('.benchmark-next');
  const position = document.querySelector<HTMLOutputElement>('.benchmark-position');
  const cards = carousel?.querySelectorAll<HTMLElement>('.benchmark-card');
  if (carousel && previous && next && position && cards?.length) {
    const step = () => cards[1].offsetLeft - cards[0].offsetLeft;
    const update = () => {
      previous.disabled = carousel.scrollLeft <= 2;
      next.disabled = carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 2;
      position.textContent = `${Math.round(carousel.scrollLeft / step()) + 1} / ${cards.length}`;
    };
    const scroll = (direction: number) => carousel.scrollBy({ left: direction * step(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    previous.addEventListener('click', () => scroll(-1));
    next.addEventListener('click', () => scroll(1));
    carousel.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(carousel);
    previous.hidden = false;
    next.hidden = false;
    update();
  }
</script>
